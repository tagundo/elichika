{
  "_comment": "Declarative mirror of the elichika_utility.sh menu. label_id names a string resource (localized); label is the fallback. type=binary runs libelichika.so with args (server stopped first); type=url opens a browser; type=import_zip opens the file picker; type=settings/about open dialogs.",
  "actions": [
    {
      "id": "download_archive",
      "label_id": "act_download_archive",
      "label": "Download all game files (archive.org)",
      "type": "binary",
      "args": ["download_archive", "both"],
      "stop_server": true
    },
    {
      "id": "download_packs",
      "label_id": "act_download_packs",
      "label": "Download missing (game CDN)",
      "type": "binary",
      "args": ["download_packs", "4"],
      "stop_server": true
    },
    {
      "id": "cdn_cache_toggle",
      "label_id": "act_cdn_cache",
      "label": "CDN cache on/off",
      "type": "binary",
      "args": ["cdn_cache", "toggle"],
      "stop_server": true
    },
    {
      "id": "import_addon",
      "label_id": "act_import_addon",
      "label": "Import addon zip",
      "type": "import_zip"
    },
    {
      "id": "settings",
      "label_id": "act_settings",
      "label": "Settings",
      "type": "settings"
    },
    {
      "id": "about",
      "label_id": "act_about",
      "label": "About",
      "type": "about"
    },
    {
      "id": "rebuild_assets",
      "label_id": "act_rebuild_assets",
      "label": "Rebuild master data",
      "type": "binary",
      "args": ["rebuild_assets"],
      "stop_server": true,
      "advanced": true
    },
    {
      "id": "fix_training_trees",
      "label_id": "act_fix_training",
      "label": "Fix training trees",
      "type": "binary",
      "args": ["fix_training_trees"],
      "stop_server": true,
      "advanced": true
    },
    {
      "id": "gamebanana",
      "label_id": "act_gamebanana",
      "label": "GameBanana mod page",
      "type": "url",
      "url": "https://gamebanana.com/games/20519"
    },
    {
      "id": "ayakamods",
      "label_id": "act_ayakamods",
      "label": "AyakaMods mod page",
      "type": "url",
      "url": "https://ayakamods.cc/games/love-live-school-idol-festival-all-stars.217/"
    }
  ]
}
