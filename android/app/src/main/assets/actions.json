{
  "_comment": "Declarative mirror of the elichika_utility.sh menu. Add an entry here to surface a new action in the app's Console tab — no Kotlin changes needed. type=binary runs libelichika.so with args (the server is stopped first); type=url opens a browser. CDN cache on/off and the CDN source URL are set in the Server WebUI admin page, not here.",
  "actions": [
    {
      "id": "download_archive",
      "label": "전체 게임파일 다운로드 (archive.org · 권장)",
      "type": "binary",
      "args": ["download_archive", "both"],
      "stop_server": true
    },
    {
      "id": "download_packs",
      "label": "누락분만 받기 (게임 CDN)",
      "type": "binary",
      "args": ["download_packs", "4"],
      "stop_server": true
    },
    {
      "id": "cdn_cache_toggle",
      "label": "CDN 캐시 켜기/끄기",
      "type": "binary",
      "args": ["cdn_cache", "toggle"],
      "stop_server": true
    },
    {
      "id": "import_addon",
      "label": "애드온 zip 가져오기",
      "type": "import_zip"
    },
    {
      "id": "rebuild_assets",
      "label": "마스터 데이터 재빌드",
      "type": "binary",
      "args": ["rebuild_assets"],
      "stop_server": true,
      "advanced": true
    },
    {
      "id": "fix_training_trees",
      "label": "트레이닝 트리 복구",
      "type": "binary",
      "args": ["fix_training_trees"],
      "stop_server": true,
      "advanced": true
    },
    {
      "id": "gamebanana",
      "label": "GameBanana 모드페이지",
      "type": "url",
      "url": "https://gamebanana.com/games/20519"
    },
    {
      "id": "ayakamods",
      "label": "AyakaMods 모드페이지",
      "type": "url",
      "url": "https://ayakamods.cc/games/love-live-school-idol-festival-all-stars.217/"
    }
  ]
}
