{
  "_comment": "Declarative console actions. Native handlers collect download scopes and dispatch CLI or managed Python work while preserving the stop-server lifecycle.",
  "actions": [
    {
      "id": "download_archive",
      "label_id": "act_download_archive",
      "label": "Download all game files (archive.org)",
      "group": "grp_downloads",
      "type": "binary",
      "args": [
        "download_archive",
        "both"
      ],
      "stop_server": true
    },
    {
      "id": "download_packs",
      "label_id": "act_download_packs",
      "label": "Download missing…",
      "group": "grp_downloads",
      "type": "binary",
      "args": [
        "download_packs",
        "4",
        "--region",
        "gl",
        "--platform",
        "android",
        "--language",
        "all"
      ],
      "stop_server": true
    },
    {
      "id": "cdn_cache_toggle",
      "label_id": "act_cdn_cache",
      "label": "CDN cache on/off",
      "group": "grp_downloads",
      "type": "binary",
      "args": [
        "cdn_cache",
        "toggle"
      ],
      "stop_server": true
    },
    {
      "id": "guide",
      "label_id": "act_guide",
      "label": "Guide",
      "group": "grp_general",
      "type": "guide"
    },
    {
      "id": "settings",
      "label_id": "act_settings",
      "label": "Settings",
      "group": "grp_general",
      "type": "settings"
    },
    {
      "id": "about",
      "label_id": "act_about",
      "label": "About",
      "group": "grp_general",
      "type": "about"
    },
    {
      "id": "gamebanana",
      "label_id": "act_gamebanana",
      "label": "GameBanana mod page",
      "group": "grp_pages",
      "type": "url",
      "url": "https://gamebanana.com/games/20519"
    },
    {
      "id": "ayakamods",
      "label_id": "act_ayakamods",
      "label": "AyakaMods mod page",
      "group": "grp_pages",
      "type": "url",
      "url": "https://ayakamods.com/games/love-live-school-idol-festival-all-stars.217/"
    },
    {
      "id": "rebuild_assets",
      "label_id": "act_rebuild_assets",
      "label": "Rebuild master data",
      "type": "binary",
      "args": [
        "rebuild_assets"
      ],
      "stop_server": true,
